# Google Maps Platform API Keys (Used for HD Map Tiles & Street Address Geocoding)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_api_key_here"
GOOGLE_MAPS_KEY="your_google_maps_api_key_here"

# Postgres (Neon / Vercel) — durable database connection (pooled)
# Injected automatically by the Neon Vercel integration; for local dev paste your Neon pooled URL.
DATABASE_URL="postgresql://user:password@your-neon-host-pooler.neon.tech/dbname?sslmode=require"

# REQUIRED: signs JWTs, password hashes, and email/OTP verification tokens.
# Generate one with:  openssl rand -hex 32
# If unset, the server uses a random per-process secret (sessions will not survive restarts).
JWT_SECRET="replace_with_a_long_random_secret"

# Admin portal credentials. Admin login is DISABLED unless both are set.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="a_strong_unique_password"

# Transactional email (verification + password reset codes).
# Without this, codes are only returned in non-production environments.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FeeTrust Security <onboarding@resend.dev>"

# Optional: webhook (e.g. Slack) notified when the database probe reports degraded.
ALERT_WEBHOOK_URL=""

# Gemini AI Assistant API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Public Host URL
APP_URL="https://feetrust.com"
